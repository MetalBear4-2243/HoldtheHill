# Normalize text files
* text=auto

# Unity text assets: merge with Unity's Smart Merge (configured in .git/config)
*.unity    merge=unityyamlmerge eol=lf
*.prefab   merge=unityyamlmerge eol=lf
*.asset    merge=unityyamlmerge eol=lf
*.mat      merge=unityyamlmerge eol=lf
*.anim     merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.meta     merge=unityyamlmerge eol=lf
*.cs       text diff=csharp

# Large binary files -> Git LFS
# Images
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.jpeg    filter=lfs diff=lfs merge=lfs -text
*.psd     filter=lfs diff=lfs merge=lfs -text lockable
*.tga     filter=lfs diff=lfs merge=lfs -text
*.tif     filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text lockable
*.ase      filter=lfs diff=lfs merge=lfs -text lockable
*.kra     filter=lfs diff=lfs merge=lfs -text lockable
*.afphoto filter=lfs diff=lfs merge=lfs -text lockable
# Audio
*.wav     filter=lfs diff=lfs merge=lfs -text
*.mp3     filter=lfs diff=lfs merge=lfs -text
*.ogg     filter=lfs diff=lfs merge=lfs -text
*.aif     filter=lfs diff=lfs merge=lfs -text
*.flac    filter=lfs diff=lfs merge=lfs -text
*.bank    filter=lfs diff=lfs merge=lfs -text
# 3D / video / fonts
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.blend   filter=lfs diff=lfs merge=lfs -text lockable
*.obj     filter=lfs diff=lfs merge=lfs -text
*.mp4     filter=lfs diff=lfs merge=lfs -text
*.mov     filter=lfs diff=lfs merge=lfs -text
*.ttf     filter=lfs diff=lfs merge=lfs -text
*.otf     filter=lfs diff=lfs merge=lfs -text
# Other binaries
*.dll     filter=lfs diff=lfs merge=lfs -text
*.so      filter=lfs diff=lfs merge=lfs -text
*.a       filter=lfs diff=lfs merge=lfs -text
*.zip     filter=lfs diff=lfs merge=lfs -text

# --- Exemptions ---
# TextMesh Pro's package assets were committed as plain Git blobs before the LFS
# rules above existed. The rules match them by extension, so Git cleans them to
# pointers when diffing, they never match the stored blobs, and every fresh clone
# reports ~26 modified files under Assets/TextMesh Pro/ that nobody changed.
# Unsetting the filters here makes Git compare them as ordinary binaries again.
# Imported package content, never hand-edited, so LFS buys us nothing on it.
"unity/Assets/TextMesh Pro/**" -filter -diff -merge
